{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract D - GraphRecord & Evidence",
  "description": "Knowledge graph edge with biological signs and evidence references",
  "type": "object",
  "required": [
    "edge_id",
    "source",
    "target",
    "metaedge",
    "relation_type",
    "sign",
    "evidence_ids",
    "source_dataset"
  ],
  "properties": {
    "edge_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "metaedge": {
      "type": "string"
    },
    "relation_type": {
      "type": "string"
    },
    "assertion_status": {
      "type": "string",
      "enum": [
        "asserted",
        "negated",
        "uncertain"
      ]
    },
    "sign": {
      "type": "integer",
      "enum": [
        -1,
        0,
        1
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pmids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_dataset": {
      "type": "string",
      "enum": [
        "hetionet_v1.0",
        "nlp_literature",
        "hybrid"
      ]
    },
    "tier": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    }
  }
}